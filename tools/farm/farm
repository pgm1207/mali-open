def pid_alive(pid):
    """alive and not a zombie (an exited child keeps its /proc entry until its parent reaps it)"""
    try:
        st = open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[0]
    except (OSError, IndexError):
        return False
    return st not in ("Z", "X")


def hold_beat(hid, watch_pid=0):
    """heartbeat loop (the hold command's own thread, or the detached --lease helper): until released, finished, or the watched pid is gone"""
    while True:
        try:
            h = L.read_json(H.path(hid))
        except (OSError, ValueError):
            return
        if h["state"] == "done" or H.released(hid):
            return
        if watch_pid and not pid_alive(watch_pid):
            return
        H.touch(hid, "hb")
        time.sleep(H.HB_EVERY)


def hold_wait_active(hid, wait_max):
    """block until farmd starts the hold; -> the active hold dict. Exits (rc 3) when farmd cancels it or wait_max elapses"""
    t0, last = time.time(), None
    while True:
        h = L.read_json(H.path(hid))
        if h["state"] == "active":
            return h
        if h["state"] == "done":
            raise SystemExit(f"farm hold: {hid} ended before it started: {h.get('reason')}")
        if time.time() - t0 > wait_max:
            H.touch(hid, "rel")
            raise SystemExit(f"farm hold: still queued after {int(wait_max)}s, cancelled (queue position {last})")
        pos = len([x for x in H.queued(H.list_holds(), h["device"]) if H.key(x) < H.key(h)])
        if pos != last:
            print(f"farm hold: {hid} queued on {h['device']}, {pos} hold(s) ahead", file=sys.stderr, flush=True)
            last = pos
        H.touch(hid, "hb")
        time.sleep(1)


def hold_env(h):
    t = h["serial"]
    e = dict(os.environ, ANDROID_SERIAL=t, ADB_SERIAL=t, QSAFE_HELD=h["lock"], FARM_HOLD=h["id"], FARM_HOLD_DEVICE=h["device"])
    e["ADB_SERIAL_" + h["lock"].upper()] = t
    return e


def hold_finish(hid):
    """release and wait for farmd's cleanup; prints the one-line outcome on stderr"""
    H.touch(hid, "rel")
    t0 = time.time()
    while time.time() - t0 < 150:
        h = L.read_json(H.path(hid))
        if h["state"] == "done":
            print(f"farm hold: {hid} released ({h.get('reason')}); phone {'restored clean' if h.get('clean') else 'RESTORE PROBLEM: ' + str(h.get('clean_note'))}", file=sys.stderr)
            return h
        time.sleep(0.5)
    print(f"farm hold: {hid} release requested; farmd is still cleaning up", file=sys.stderr)


def cmd_hold(a):
    _, devs = L.load_devices()
    if a.release or a.status:
        h = L.read_json(H.path(a.release or a.status))
        if a.status:
            print(json.dumps(h, indent=1, sort_keys=True))
            return 0
        hold_finish(h["id"])
        return 0
    if a.device not in devs:
        raise SystemExit(f"farm hold: unknown device {a.device!r} (have: {', '.join(devs)})")
    cmd = a.command or []
    if bool(cmd) == bool(a.lease):
        raise SystemExit("farm hold: give either `-- <command>` or --lease")
    if not a.max or not math.isfinite(a.max) or a.max <= 0 or not math.isfinite(a.wait_max) or a.wait_max <= 0:
        raise SystemExit("farm hold: --max <minutes> is required (a finite number > 0); --wait-max must be finite too")
    h = H.new_hold(a.device, a.max * 60, a.prio, bool(a.lease), who=os.environ.get("FARM_WHO", ""))
    hid = h["id"]
    import signal, threading
    beat = threading.Thread(target=hold_beat, args=(hid,), daemon=True)
    beat.start()
    def die(*_):
        H.touch(hid, "rel")
        raise SystemExit(130)
    signal.signal(signal.SIGTERM, die)
    h = hold_wait_active(hid, a.wait_max * 60)
    print(f"farm hold: {hid} active on {h['device']} (serial {h['serial']}, lock {h['lock']}, max {a.max} min)", file=sys.stderr, flush=True)
    if a.lease:
        print(json.dumps({"hold": hid, "device": h["device"], "serial": h["serial"], "lock": h["lock"], "deadline": h["deadline"]}))
        # a detached helper keeps the lease alive until `farm hold --release`, the max time, or --watch-pid exits
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "hold", "--beat", hid, "--watch-pid", str(a.watch_pid)], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0
    def child_setup():                                    # the command dies with us: no orphan holding a phone that is being released
        import ctypes
        ctypes.CDLL("libc.so.6").prctl(1, signal.SIGKILL)
        os.setsid()
    try:
        p = subprocess.Popen(cmd, env=hold_env(h), preexec_fn=child_setup)
    except OSError as e:                                  # the command never started: give the phone back, keep the error for the caller
        print(f"farm hold: cannot run {cmd[0]!r}: {e}", file=sys.stderr)
        hold_finish(hid)
        return 127
    try:
        while True:
            try:
                rc = p.wait(timeout=2)
                break
            except subprocess.TimeoutExpired:
                cur = L.read_json(H.path(hid))
                if cur["state"] != "active" or time.time() > cur["deadline"]:
                    print(f"farm hold: {hid} ended while the command ran ({cur.get('reason') or 'max time'}): killing it", file=sys.stderr)
                    os.killpg(p.pid, signal.SIGKILL)
                    p.wait()
                    rc = 124
                    break
    except KeyboardInterrupt:
        os.killpg(p.pid, signal.SIGKILL)
        rc = 130
    try:
        os.killpg(p.pid, signal.SIGKILL)                   # background workers the command left behind must not touch the phone after the release
    except OSError:
        pass
    hold_finish(hid)
    return rc


def cmd_hold_beat(a):
    """internal: keep a --lease alive. Stops at release, done, deadline or when --watch-pid is gone"""
    hold_beat(a.beat, a.watch_pid)
    return 0


def wait_line(j):
    """one compact line for a job: id suite commit verdict, then per class `v11:pass` / `v13:fail(2 new)` / `v10:pending`"""
    parts = []
    for c, p in j["parts"].items():
        if p["state"] == "done":
            rp = L.run_path(j["id"], c)
            run = L.read_json(rp) if os.path.exists(rp) else {}
            nf = len(run.get("new_failures") or [])
            parts.append(f"{c}:{p.get('verdict')}" + (f"({nf} new)" if nf else "") + (f" [{run['notes'][:60]}]" if run.get("notes") and p.get("verdict") != "pass" else ""))
        else:
            parts.append(f"{c}:{p['state']}")
    return f"{j['id']} {j['suite']} {j['commit'][:7]} {L.job_verdict(j)} " + " ".join(parts)


def cmd_wait(a):
    ids = [L.find_job(x)["id"] for x in a.job]
    multi = len(ids) > 1 or a.any or a.all
    if a.any and a.all:
        raise SystemExit("farm wait: --any and --all are exclusive")
    t0 = time.time()
    while True:
        js = [L.find_job(i) for i in ids]
        vs = [L.job_verdict(j) for j in js]
        done = [v != "pending" for v in vs]
        if not multi:
            if done[0]:
                print(vs[0])
                return {"pass": 0, "fail": 1}.get(vs[0], 2)
        elif (any(done) if a.any else all(done)):
            for j, d in zip(js, done):
                if d or not a.any:
                    print(wait_line(j))
            worst = [v for v, d in zip(vs, done) if d]
            return 0 if all(v == "pass" for v in worst) else (1 if all(v in ("pass", "fail") for v in worst) else 2)
        if time.time() - t0 > a.timeout:
            if not multi:
                print("timeout: " + " ".join(f"{c}:{p['state']}" for c, p in js[0]["parts"].items()))
            else:
                print(f"timeout after {int(a.timeout)}s:")
                for j in js:
                    print("  " + wait_line(j))
            return 3
        time.sleep(min(a.poll, max(0.1, a.timeout - (time.time() - t0))))



+  /* mali-open: local DXVK compatibility shim (built only by DroidDeck's
+     tools/dxvk). The Mali driver we run cannot provide these required
+     features, and none of the titles we ship create a pipeline that uses
+     them, so device creation continues instead of failing. Every relaxation
+     is logged at warning level; a missing entry here keeps the original
+     hard failure. */
+  static bool maliRelaxedRequiredFeature(const char* name) {
+    const std::string n = name;
+
+    // mali-open: dxvk compat relaxation: geometryShader absent, allowed
+    if (n == "geometryShader") {
+      Logger::warn("mali-open: dxvk compat relaxation: geometryShader absent, allowed");
+      return true;
+    }
+
+    // mali-open: dxvk compat relaxation: shaderCullDistance absent, allowed
+    if (n == "shaderCullDistance") {
+      Logger::warn("mali-open: dxvk compat relaxation: shaderCullDistance absent, allowed");
+      return true;
+    }
+
+    return false;
+  }
+

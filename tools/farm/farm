def cmd_digest(a):
    _, devs = L.load_devices()
    print_devices(devs)
    jobs = L.list_jobs()
    st = {}
    run_now = []
    for j in jobs:
        for c, p in j["parts"].items():
            st[p["state"]] = st.get(p["state"], 0) + 1
            if p["state"] == "running":
                run_now.append(f"{j['id']}/{c} ({j['ref']} {j['suite']}) on {p.get('device')}")
    by_cls, pos = L.queue_view(jobs, BL.order_jobs)
    print("queue by class: " + "; ".join(f"{c} {q} pending, {r} running" for c, (r, q) in sorted(by_cls.items())))
    for j in BL.order_jobs(jobs):
        ps = [f"{c}#{pos[(j['id'], c)]}" for c in j["parts"] if (j["id"], c) in pos]
        if ps:
            print(f"  pending {j['id']} {j['suite']:5} p{L.job_prio(j):<2} {j['ref'][:22]:22} " + " ".join(ps))
    print("queue: " + ", ".join(f"{n} {k}" for k, n in sorted(st.items())) + ("; running " + "; ".join(run_now) if run_now else ""))
    classes = sorted({d["class"] for d in devs.values()})
    def latest(ref, suite, cls):
        for j in reversed(jobs):
            if j["ref"] == ref and j["suite"] == suite and finished(j, cls):
                return j
    mains = {c: latest("main", "daily", c) for c in classes}
    refs = []
    for j in reversed(jobs):
        if j["ref"] not in refs:
            refs.append(j["ref"])
    lines = []
    for ref in refs:
        for cls in classes:
            sm, dl = latest(ref, "smoke", cls), latest(ref, "daily", cls)
            if not (sm or dl):
                continue
            seg = []
            for tag, j in (("smoke", sm), ("daily", dl)):
                if j:
                    run = L.read_json(L.run_path(j["id"], cls)) if os.path.exists(L.run_path(j["id"], cls)) else {}
                    seg.append(f"{tag} {j['parts'][cls]['verdict']} {counts_str(run)}{flaky_str(run) if tag == 'daily' else ''} [{j['id'][9:15]}-{j['commit'][:7]}]")
            lines.append(f"{ref[:22]:22} {cls:4} " + " | ".join(seg))
            m = mains.get(cls)
            if dl and m and ref != "main":
                a1, b1 = job_tsv(m, cls), job_tsv(dl, cls)
                if a1 and b1:
                    worse = [c for c, s in a1.items() if s == "Pass" and b1.get(c, "Missing") != "Pass"]
                    ns = [c for c in worse if b1.get(c) == "NotSupported"]
                    known = {c for (c, g) in L.load_flaky_db() if g == cls}
                    new = [c for c in worse if c not in known]
                    if worse:
                        lines.append(f"    vs main {m['commit'][:7]}: {len(worse)} regressed ({len(ns)} ->NS): {names(worse)}; "
                                     f"new Fails against main: {len(new)}" + (f" ({len(worse) - len(new)} on the flaky list)" if len(new) != len(worse) else ""))
                    else:
                        lines.append(f"    vs main {m['commit'][:7]}: new Fails against main: 0")
    brows = BL.load_rows(L.state_dir())                                                                                         # one read for both sections
    bl = BL.digest_lines(brows) + BL.regressions(brows) + BL.menu_digest_lines(L.state_dir())          # latest bench per phone always shown (not cut by the room limit)
    room = max(0, 40 - 4 - len(devs) - len(bl))
    print("\n".join(bl + lines[:room]) + (f"\n... {len(lines) - room} more lines (older refs)" if len(lines) > room else ""))


def group_of(case, depth=5):
    return ".".join(case.split(".")[:depth])


def cmd_flaky(a):
    if a.seed:
        found = L.flip_scan(a.days)
        for g in sorted({g for _, g in found}):
            L.record_flaky([(c, f, r) for (c, gg), (f, r, t0, t1) in sorted(found.items()) if gg == g], g, seed=True)
        db = L.load_flaky_db()
        for (c, g), (f, r, t0, t1) in found.items():            # seed with the real first/last seen times
            if (c, g) in db:
                db[(c, g)][2:] = [t0, t1]
        L.write_flaky_db(db)
        for g in sorted({g for _, g in found}):
            grp = {}
            for (c, gg) in found:
                if gg == g:
                    grp[group_of(c)] = grp.get(group_of(c), 0) + 1
            print(f"{g}: {sum(grp.values())} flipped case(s) in the last {a.days} days; top groups: "
                  + ", ".join(f"{k.replace('dEQP-VK.', '')} {n}" for k, n in sorted(grp.items(), key=lambda kv: -kv[1])[:8]))
        if not found:
            print(f"no case flipped Pass/Fail on the same build in the last {a.days} days")
        return
    db = L.load_flaky_db()
    rows = sorted(((g, c, v) for (c, g), v in db.items() if not a.cls or g == a.cls), key=lambda r: (r[0], -r[2][0], r[1]))
    if not rows:
        print("flaky list is empty")
        return
    print(f"{'gpu':4} {'fails/runs':>10}  {'first seen':19}  {'last seen':19}  case")
    for g, c, (f, r, t0, t1) in rows:
        print(f"{g:4} {f:>4}/{r:<5}  {t0[:19]:19}  {t1[:19]:19}  {c}")
    print(f"{len(rows)} case(s) in {L.flaky_path()}")



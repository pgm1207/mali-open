def git(*a, env=None):
    r = subprocess.run(["git", "-C", os.path.dirname(os.path.realpath(__file__)), *a], capture_output=True, text=True, env=env)
    if r.returncode:
        raise SystemExit("farm: git " + " ".join(a) + ": " + r.stderr.strip())
    return r.stdout.strip()


def cmd_submit(a):
    cfg, devs = L.load_devices()
    batch = None
    if a.batch and a.stack:
        raise SystemExit("farm: use either --batch or --stack, not both")
    if a.batch or a.stack:
        stack = bool(a.stack)
        refs = [r.strip() for r in (a.stack or a.batch).split(",") if r.strip()]
        if len(refs) < 2:
            raise SystemExit(f"farm: --{'stack' if stack else 'batch'} needs at least two comma-separated refs")
        commits = [git("rev-parse", "--verify", r + "^{commit}") for r in refs]
        if stack:                                          # dependency order: base PR first; a ref may not be an ancestor of an EARLIER one
            for i, ci in enumerate(commits):
                for j in range(i):
                    if ci != commits[j] and subprocess.run(["git", "-C", os.path.dirname(os.path.realpath(__file__)), "merge-base", "--is-ancestor", ci, commits[j]]).returncode == 0:
                        raise SystemExit(f"farm: --stack: {refs[i]} is an ancestor of {refs[j]} but listed after it; list the stack base first")
        commit = commits[0]
        prefix = [commit]                                  # prefix[i] = refs[0..i] merged: what a failed stack bisects over
        for r, c in zip(refs[1:], commits[1:]):
            m = subprocess.run(["git", "-C", os.path.dirname(os.path.realpath(__file__)), "merge-tree", "--write-tree", commit, c], capture_output=True, text=True)
            if m.returncode:
                raise SystemExit(f"farm: --batch: {r} conflicts with the refs before it ({m.stdout.strip().splitlines()[-1] if m.stdout.strip() else m.stderr.strip()})")
            commit = git("commit-tree", m.stdout.splitlines()[0], "-p", commit, "-p", c, "-m", f"farm: {'stack' if stack else 'batch'} merge of {r} (gate only)", env=MERGE_ENV)
            prefix.append(commit)
        batch = {"refs": refs, "commits": commits}
        if stack:
            batch["stack"] = True
            batch["commits"] = prefix                     # bisect gates each prefix (base..PR i), never a dependent PR alone
        a.ref = ("stack:" if stack else "batch:") + "+".join(refs)
        a.keep_old = True                                  # a batch never supersedes (or is superseded by) a branch gate
    elif not a.ref:
        raise SystemExit("farm: submit needs a REF, --batch r1,r2,... or --stack r1,r2,...")
    else:
        commit = git("rev-parse", "--verify", a.ref + "^{commit}")
    head = git("rev-parse", "HEAD")
    om = subprocess.run(["git", "-C", os.path.dirname(os.path.realpath(__file__)), "rev-parse", "--verify", "-q", "origin/main^{commit}"], capture_output=True, text=True)
    om = om.stdout.strip() if om.returncode == 0 else ""
    if a.merge_with_main:
        if not om:
            raise SystemExit("farm: --merge-with-main needs origin/main (git fetch)")
        commit_pre = commit
        tree = git("merge-tree", "--write-tree", commit, om)               # fails (exit 1) on conflicts
        commit = git("commit-tree", tree.splitlines()[0], "-p", commit, *([] if commit == om else ["-p", om]), "-m", f"farm: {a.ref} merged with origin/main {om[:8]} (gate only)",
                     env=MERGE_ENV)           # fixed identity and dates: the same REF + origin/main always gives the same commit, so reuse works
        if batch and batch.get("stack"):                   # each bisect prefix is gated with main too, else a regression that needs main passes the diagnostics
            pm = []
            for r, pc in zip(batch["refs"], batch["commits"]):
                if pc == commit_pre:
                    pm.append(commit)                          # the full stack is the job commit itself
                    continue
                pt = git("merge-tree", "--write-tree", pc, om)
                pm.append(git("commit-tree", pt.splitlines()[0], "-p", pc, *([] if pc == om else ["-p", om]), "-m", f"farm: stack prefix {r} merged with origin/main {om[:8]} (gate only)", env=MERGE_ENV))
            batch["commits"] = pm
        a.ref = f"{a.ref}+main"
    elif om and not a.allow_stale:
        behind = int(git("rev-list", "--count", f"{commit}..{om}"))
        if behind > L.STALE_COMMITS:
            raise SystemExit(f"farm: {a.ref} is {behind} commits behind origin/main (limit {L.STALE_COMMITS}); rebase, use --merge-with-main, or --allow-stale")
    dirty = bool(git("status", "--porcelain", "--untracked-files=no")) and commit == head   # uncommitted edits are NOT tested
    classes = sorted({d["class"] for d in devs.values()})
    need = [c.strip() for c in a.need.split(",") if c.strip()] if a.need else classes
    for c in need:
        if c not in classes:
            print(f"farm: warning: no device of class {c} configured; that part stays pending", file=sys.stderr)
    if a.only and a.suite != "smoke":
        raise SystemExit("farm: --only is for --suite smoke")
    if a.suite == "cases" and not a.case:
        raise SystemExit("farm: --suite cases needs at least one --case <dEQP case name>")
    if not need:
        raise SystemExit("farm: --need selects no class")
    if a.prio is None and a.suite == "cases" and len(a.case) == 1 and a.repeat <= 1:
        a.prio = L.SINGLE_CASE_PRIO                              # a lane's one-case diagnostic must not wait behind a 15 min full cases run
    if not a.rerun:                                              # (dirty edits are never tested, so the commit alone identifies the job) the identical job already queued/running: return it, never double-queue
        inflight = L.find_inflight(L.list_jobs(), commit, a.suite, need, L.parse_env(a.env), a.only, a.case, a.repeat)
        if inflight:
            print(f"farm: same commit/suite/class is already {L.job_verdict(inflight)} as {inflight['id']}; not resubmitting (--rerun forces)", file=sys.stderr)
            print(inflight["id"])
            return
    if not a.rerun and not dirty and a.suite == "smoke":        # reuse only where the verdict does not depend on a moving input: daily judges against main's baseline, menu/bench against the installed MediaDeck
        old = L.find_passed(L.list_jobs(), commit, a.suite, need, L.parse_env(a.env), a.only, a.case, a.repeat)
        if old:
            print(f"farm: same commit/suite/inputs already passed as {old['id']}; not resubmitting (--rerun forces)", file=sys.stderr)
            print(old["id"])
            return
    job = L.new_job(a.ref, commit, dirty, a.suite, need, L.parse_env(a.env), os.path.basename(git("rev-parse", "--show-toplevel")),
                    cases=a.case, repeat=a.repeat, only=a.only, prio=a.prio, keep_old=a.keep_old)
    if batch:
        job["batch"] = batch
        L.write_json(L.job_path(job["id"]), job)
    if dirty:
        print("farm: warning: working tree has uncommitted changes; only the committed state is tested", file=sys.stderr)
    if not a.keep_old:
        def anc(old, new):
            r = subprocess.run(["git", "-C", os.path.dirname(os.path.realpath(__file__)), "merge-base", "--is-ancestor", old, new], capture_output=True)
            return r.returncode == 0
        for jid, old, cs in L.supersede_old_gates(job, L.list_jobs(), anc):
            msg = f"supersede: {jid} ({old[:8]}) pending {','.join(cs)} cancelled by newer {job['suite']} {job['id']} ({commit[:8]}); --keep-old opts out"
            print("farm: " + msg, file=sys.stderr)
            os.makedirs(os.path.join(L.state_dir(), "logs"), exist_ok=True)
            with open(os.path.join(L.state_dir(), "logs", "farm-queue.log"), "a") as f:
                f.write(f"{L.now()} {msg}\n")
    print(job["id"])


def cmd_batch(a):
    """per-branch result of a `submit --batch` job (farmd bisects a failed batch by running every branch alone)"""
    j = L.find_job(a.job)
    b = j.get("batch")
    if not b:
        raise SystemExit(f"farm: {j['id']} is not a batch job")
    print(f"{j['id']} {'stack' if b.get('stack') else 'batch'} {L.job_verdict(j)}: {', '.join(b['refs'])}")
    bis = j.get("bisect") or {}
    if L.job_verdict(j) == "pass":
        print("  all PRs of the stack pass together" if b.get("stack") else "  all branches pass together")
    elif not bis:
        print("  bisect not started yet" if L.job_verdict(j) == "fail" else "  no bisect (batch did not fail)")
    for ref, jid in bis.items():
        print(f"  {ref:30} {jid} {L.job_verdict(L.find_job(jid))}")
    if bis and all(L.job_verdict(L.find_job(i)) == "pass" for i in bis.values()):
        print("  every branch passes alone: the failure is an interaction between them")
    if b.get("stack") and bis:
        first = None                                       # definitive only when every earlier prefix passed; a pending/error/cancelled earlier prefix makes it incomplete
        for r in b["refs"]:
            v = L.job_verdict(L.find_job(bis[r])) if bis.get(r) else "pending"
            if v == "pass":
                continue
            if v == "fail":
                first = r
            break
        if first:
            print(f"  first failing prefix: {first} (stack base..{first})")
        elif any(L.job_verdict(L.find_job(i)) != "pass" for i in bis.values()):
            print("  diagnosis incomplete: an earlier prefix has no passing result yet")


